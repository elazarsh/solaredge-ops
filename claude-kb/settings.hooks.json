{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {"type": "command", "command": "$HOME/.claude/hooks/session-context.sh"}
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "python3 $HOME/.claude/hooks/skill-router.py"}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "$HOME/.claude/hooks/guard-destructive.sh"}
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {"type": "command", "command": "python3 $HOME/.claude/hooks/guard-files-secrets.py"}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {"type": "command", "command": "$HOME/.claude/hooks/post-edit-check.sh"}
        ]
      }
    ]
  }
}
