   "verified": true,
   "lines": [
    "״וַיַּרְא אֶת הַמָּקוֹם מֵרָחֹק״.",
    "עַל הָהָר קָשׁוּר עָנָן,",
    "עַל כִּתְפֵי הַבֵּן — עֲצֵי הַמַּעֲרָכָה,",
